<mxCell id="p1-status" value="&lt;div style=&quot;font-size:13px&quot;&gt;&lt;b&gt;Job status worker&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;margin-top:4px;line-height:1.3&quot;&gt;progress per item and step&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;metaEdit=1;spacing=10;rounded=1;arcSize=8;align=center;verticalAlign=middle;fillColor=#05767A;strokeColor=#045B5E;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="640" y="325" width="200" height="64" as="geometry"/></mxCell>
