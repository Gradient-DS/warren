<diagram id="p1" name="1 Architecture">
<mxGraphModel adaptiveColors="none" dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="p1-bg" value="" style="rounded=0;fillColor=#FFFFFF;strokeColor=none;connectable=0;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="10" y="10" width="1080" height="715" as="geometry"/></mxCell>
<mxCell id="p1-t1" value="&lt;b&gt;Warren: architecture&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#0B2A3F;fontFamily=Helvetica;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="600" height="30" as="geometry"/></mxCell>
<mxCell id="p1-pub" value="&lt;div style=&quot;font-size:13px&quot;&gt;&lt;b&gt;Job publisher&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;margin-top:4px;line-height:1.3&quot;&gt;your code&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;metaEdit=1;spacing=10;rounded=1;arcSize=8;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#0B2A3F;fontColor=#0B2A3F;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="170" height="60" as="geometry"/></mxCell>
<mxCell id="p1-t2" value="&lt;b style=&quot;color:#006B50&quot;&gt;1&lt;/b&gt;&amp;nbsp; A worker receives a small message that points to its input&lt;br&gt;&lt;b style=&quot;color:#006B50&quot;&gt;2&lt;/b&gt;&amp;nbsp; It reads the input, from the cache when it is there&lt;br&gt;&lt;b style=&quot;color:#006B50&quot;&gt;3&lt;/b&gt;&amp;nbsp; It stores its result&lt;br&gt;&lt;b style=&quot;color:#006B50&quot;&gt;4&lt;/b&gt;&amp;nbsp; It publishes a small message that points to the result&lt;br&gt;&lt;br&gt;To scale a step, start more copies of that worker." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#0B2A3F;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="78" width="560" height="110" as="geometry"/></mxCell>
<mxCell id="p1-broker" value="&lt;div style=&quot;font-size:13px&quot;&gt;&lt;b&gt;Message broker&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10.5px;margin-top:4px;line-height:1.3&quot;&gt;RabbitMQ, Kafka or in-memory&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;metaEdit=1;spacing=10;rounded=1;arcSize=8;align=center;verticalAlign=middle;fillColor=#0B273C;strokeColor=#081C2B;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="1020" height="56" as="geometry"/></mxCell>
<mxCell id="p1-g1" value="Your workers" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;arcSize=12;absoluteArcSize=1;fillColor=#F7FAF9;strokeColor=#6B7D8A;fontColor=#0B2A3F;fontFamily=Helvetica;labelBackgroundColor=none;align=left;verticalAlign=bottom;spacing=10;fontSize=11;metaEdit=1;connectable=0;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="25" y="310" width="550" height="125" as="geometry"/></mxCell>
<mxCell id="p1-g2" value="Warren support workers" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;arcSize=12;absoluteArcSize=1;fillColor=#F7FAF9;strokeColor=#6B7D8A;fontColor=#0B2A3F;fontFamily=Helvetica;labelBackgroundColor=none;align=left;verticalAlign=bottom;spacing=10;fontSize=11;metaEdit=1;connectable=0;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="625" y="310" width="450" height="125" as="geometry"/></mxCell>
